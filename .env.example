# Environment variables read by the workflows through $env.
# Set these on the n8n host. Every value below is a placeholder.
# API keys do not belong here. Create them as n8n credentials instead.

# Name used in customer facing messages
BUSINESS_NAME=Sample Home Services

# Number that texts are sent from
BUSINESS_PHONE=+15555550100

# Where urgent alerts are texted
OWNER_PHONE=+15555550101

# Where the digest and last resort alerts go
OWNER_EMAIL=owner@example.com

# Public review page
REVIEW_LINK=https://reviews.example.com/sample-home-services

# Base URL of the CRM REST API
CRM_BASE_URL=https://crm.example.com/api

# Base URL of the invoicing API
ACCOUNTING_API_URL=https://accounting.example.com/api

# Base URL of the HR or task system API
HR_API_URL=https://hr.example.com/api

# Base URL of the calendar API
CALENDAR_API_URL=https://calendar.example.com/api

# Endpoint that sends one text message
SMS_API_URL=https://sms.example.com/api/messages

# Endpoint that sends one email
EMAIL_API_URL=https://email.example.com/api/send

# Incoming webhook for the office channel
TEAM_CHAT_WEBHOOK_URL=https://chat.example.com/hooks/office

# Incoming webhook for the alerts channel
ALERT_WEBHOOK_URL=https://chat.example.com/hooks/alerts

# Endpoint that stores failed items for replay
DEAD_LETTER_URL=https://ops.example.com/api/dead-letters
