{
  "name": "New Hire Onboarding",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-hire",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1924d7cd-c9ea-57ae-95e7-0de4b49df680",
      "name": "New hire form webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "f2286beb-5064-58e0-96ca-c6a8a0f82eaa",
      "notes": "Receives the submitted form."
    },
    {
      "parameters": {
        "jsCode": "const TEMPLATE = [\n  { title: 'Collect signed offer and tax forms', owner: 'office', dueInDays: -3 },\n  { title: 'Create email and scheduling app logins', owner: 'office', dueInDays: -2 },\n  { title: 'Order uniform and safety gear', owner: 'office', dueInDays: -2, roles: ['field technician'] },\n  { title: 'Assign vehicle and tablet', owner: 'manager', dueInDays: 0, roles: ['field technician'] },\n  { title: 'Safety orientation', owner: 'manager', dueInDays: 0 },\n  { title: 'First week ride along schedule', owner: 'manager', dueInDays: 1, roles: ['field technician'] },\n  { title: '30 day check in', owner: 'manager', dueInDays: 30 },\n];\nconst DAY = 86400000;\nreturn $input.all().map((item) => {\n  const body = item.json.body ?? item.json;\n  const start = new Date(body.startDate);\n  const complete = Boolean(body.name && body.email && body.role && body.managerEmail)\n    && !Number.isNaN(start.getTime());\n  const tasks = !complete ? [] : TEMPLATE\n    .filter((t) => !t.roles || t.roles.includes(body.role))\n    .map((t) => ({\n      title: `${t.title}: ${body.name}`,\n      owner: t.owner === 'manager' ? body.managerEmail : 'office',\n      dueDate: new Date(start.getTime() + t.dueInDays * DAY).toISOString().slice(0, 10),\n    }));\n  return { json: {\n    name: String(body.name ?? '').trim(),\n    email: String(body.email ?? '').trim().toLowerCase(),\n    role: String(body.role ?? '').trim(),\n    managerEmail: String(body.managerEmail ?? '').trim().toLowerCase(),\n    startDate: complete ? start.toISOString().slice(0, 10) : '',\n    complete,\n    tasks,\n  }};\n});\n"
      },
      "id": "b7d5b698-a413-5232-ab1d-72ac98e2b2ab",
      "name": "Build onboarding plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "notes": "Validates the form and expands the checklist template into dated tasks."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "24127b7e-05e9-5ee8-b51d-7bf995de05e6",
              "leftValue": "={{ $json.complete }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "504b9aca-87c7-51e3-93cc-ebfedd529f78",
      "name": "Form complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        300
      ],
      "notes": "Incomplete forms go to the dead letter path."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HR_API_URL }}/employees",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.name, email: $json.email, role: $json.role, startDate: $json.startDate, managerEmail: $json.managerEmail, externalKey: `${$json.email}:${$json.startDate}` }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "967d7932-82b2-593d-a4ba-a59264ae124e",
      "name": "Create HR record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HR system API"
        }
      },
      "notes": "Creates the employee record."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HR_API_URL }}/tasks/bulk",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ employeeId: $json.id, externalKey: `onboarding:${$('Build onboarding plan').item.json.email}`, tasks: $('Build onboarding plan').item.json.tasks }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "58d6930c-67e3-5dd7-9f9b-e5ea08a8977d",
      "name": "Create onboarding tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "HR system API"
        }
      },
      "notes": "Creates every checklist task in one call."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_API_URL }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Build onboarding plan').item.json.email, subject: `Welcome to ${$env.BUSINESS_NAME}`, text: `Hi ${$('Build onboarding plan').item.json.name.split(' ')[0]},\\n\\nWelcome aboard. Your first day is ${$('Build onboarding plan').item.json.startDate}. Please arrive at 7:30 with a photo ID. Your manager will meet you at the shop and walk you through the first week.\\n\\n${$env.BUSINESS_NAME}` }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "ce8ce74c-11d5-5457-a3e7-3fd589541c9b",
      "name": "Email welcome packet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
